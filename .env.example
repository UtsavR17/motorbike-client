# Copy to .env.local and fill in. Public values only: never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site origin used in auth email and OAuth redirect links (default http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
# "true" shows the "Continue with Google" button (Google must be enabled in Supabase). Default false.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Only for `npm run check:rls`: a confirmed test customer with a completed profile.
# TEST_EMAIL=
# TEST_PASSWORD=
# OTHER_CUSTOMER_ID=
