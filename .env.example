# Copy to .env.local and fill in. Public values only: never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site origin used in auth email and OAuth redirect links (default http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
# "true" shows the "Continue with Google" button (Google must be enabled in Supabase). Default false.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
# Supplier Portal login page (the Flask app), linked once a supplier application is approved.
# Development default: http://localhost:5000/supplier-portal/login. Set the real URL when deployed.
NEXT_PUBLIC_SUPPLIER_PORTAL_URL=

# Only for `npm run check:rls`: a confirmed test customer with a completed profile.
# TEST_EMAIL=
# TEST_PASSWORD=
# OTHER_CUSTOMER_ID=

# --- Payments (server-only secrets: never prefix with NEXT_PUBLIC_, never commit) ---
# Stripe test secret key (sk_test_...). Live keys are refused by the app.
STRIPE_SECRET_KEY=
# Webhook signing secret printed by `stripe listen` (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Supabase service-role key: used ONLY by the Stripe webhook route.
SUPABASE_SERVICE_ROLE_KEY=
# Charge currency: mur (default) or usd. The shop always shows Rs. and stores MUR.
STRIPE_CURRENCY=mur
# Only for STRIPE_CURRENCY=usd: rupees per US dollar (demo approximation).
STRIPE_MUR_PER_USD=46
